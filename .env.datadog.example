# Copy this file to .env.datadog on the deployment host (chmod 600). Never commit the copy.
DD_API_KEY=replace-with-datadog-api-key
DD_SITE=us5.datadoghq.com
DD_ENV=test

# Signs and verifies login tokens. Required by customer-service, product-service and
# orchestration-service, which must all use the same value (at least 32 bytes).
# Generate it on the host: openssl rand -base64 48
# Store production values in a secret manager; never commit a real secret.
AUTH_JWT_SECRET=replace-with-at-least-32-random-bytes

# Comma-separated customer IDs allowed into the admin console (orders:operate scope).
# Register the account on the storefront, look up its ID, set it here, recreate
# customer-service, then sign in. Registration never grants this scope.
AGENT_CUSTOMER_IDS=

# Optional comma-separated customer IDs that receive catalog:write on a fresh
# login. Same process as AGENT_CUSTOMER_IDS.
CATALOG_ADMIN_CUSTOMER_IDS=

# Set this to the deployed application version, image tag, or Git commit SHA.
APP_VERSION=manual

# Publish the Web UI on standard HTTP port 80 on EC2. Local development uses
# port 5173 when WEB_UI_PORT is unset.
WEB_UI_PORT=80

# Comma-separated, explicit Web UI origins. Replace YOUR_EC2_PUBLIC_IP with a
# stable Elastic IP or domain before deployment. Do not use "*".
CORS_ALLOWED_ORIGINS=http://YOUR_EC2_PUBLIC_IP

# The admin console listens on the host's loopback only; reach it through an SSH tunnel
# (ssh -N -L 5174:127.0.0.1:5174 ...), so its browser origin is localhost:5174.
ADMIN_UI_PORT=127.0.0.1:5174
ADMIN_CORS_ALLOWED_ORIGINS=http://localhost:5174,http://127.0.0.1:5174
