# Copy this file to .env.datadog on the deployment host. Never commit the copy.
DD_API_KEY=replace-with-datadog-api-key
DD_SITE=us5.datadoghq.com
DD_ENV=test

# Required by customer-service and product-service. Use the same random value
# (at least 32 bytes) in both services. Store production values in a secret
# manager; never commit a real secret.
AUTH_JWT_SECRET=replace-with-at-least-32-random-bytes

# Optional comma-separated customer IDs that receive catalog:write on a fresh
# login. Register first, copy the customer ID, set it here, recreate
# customer-service, then log in again. Registration never grants admin scope.
CATALOG_ADMIN_CUSTOMER_IDS=

# Set this to the deployed application version, image tag, or Git commit SHA.
APP_VERSION=manual

# Publish the Web UI on standard HTTP port 80 on EC2. Local development uses
# port 5173 when WEB_UI_PORT is unset.
WEB_UI_PORT=80

# Comma-separated, explicit Web UI origins. Replace YOUR_EC2_PUBLIC_IP with a
# stable Elastic IP or domain before deployment. Do not use "*".
CORS_ALLOWED_ORIGINS=http://YOUR_EC2_PUBLIC_IP

# Admin UI is private until authentication/RBAC is implemented.
ADMIN_UI_PORT=5174
ADMIN_CORS_ALLOWED_ORIGINS=http://localhost:5174
