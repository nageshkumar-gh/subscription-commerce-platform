# Copy this file to .env.datadog on the deployment host. Never commit the copy.
DD_API_KEY=replace-with-datadog-api-key
DD_SITE=datadoghq.eu
DD_ENV=test

# Set this to the deployed application version, image tag, or Git commit SHA.
APP_VERSION=manual

# Comma-separated, explicit Web UI origins. Do not use "*".
# If the UI uses host port 5173: http://YOUR_EC2_PUBLIC_IP:5173
# If the UI uses standard HTTP port 80: http://YOUR_EC2_PUBLIC_IP
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
