# Copy to local.env (git-ignored) and pass it to every compose command, e.g.
#   docker compose --env-file local.env -f customer-service/compose.yaml up -d --build
#
# Signs and verifies customer/agent login tokens (customer-service, product-service, orchestration-service).
# At least 32 random bytes, e.g.: openssl rand -base64 48
AUTH_JWT_SECRET=replace-with-at-least-32-random-bytes

# Customer IDs (comma-separated) allowed into the admin console. Register the account normally, then add its ID here
# and restart customer-service. Agents must sign in again to receive the scope.
AGENT_CUSTOMER_IDS=

# Customer IDs allowed to manage the product catalogue (product-service /api/admin/**).
CATALOG_ADMIN_CUSTOMER_IDS=
